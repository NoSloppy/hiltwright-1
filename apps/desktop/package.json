{
  "name": "@hiltwright/desktop",
  "version": "0.2.0-beta.1",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "description": "Hiltwright desktop app (Electron). Walking skeleton: connect to a Proffieboard over Web Serial, read version and presets.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "test": "vitest run",
    "shots": "node scripts/shots.mjs",
    "icons":"electron scripts/icons.mjs",
    "notices": "node scripts/notices.mjs"
  },
  "dependencies": {
    "@hiltwright/core": "*",
    "pixi.js": "^8.21.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.170.0",
    "@types/w3c-web-serial": "^1.0.8",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "37.10.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "app.hiltwright.desktop",
    "productName": "Hiltwright",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/builtin",
        "to": "builtin"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "../../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../../THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Hiltwright-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "license": "../../LICENSE",
      "artifactName": "Hiltwright-${version}-setup.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "npmRebuild": false
  },
  "author": "safwyls"
}
